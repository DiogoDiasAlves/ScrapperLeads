# Copie para ".env" se quiser mudar algo:  cp .env.example .env
#
# O scraper fica preso ao 127.0.0.1 (só a sua máquina acessa), então NÃO precisa de chave.
# A imagem do scraper não tem autenticação própria: o acesso só local é a proteção.

SCRAPER_BASE_URL=http://localhost:8080

# Só se um dia expor o scraper fora da sua máquina atrás de um proxy com autenticação
# (ex.: Caddy/nginx checando o cabeçalho X-API-Key). Deixe vazio para uso local.
SCRAPER_API_KEY=
